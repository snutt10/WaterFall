<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="center" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="csc130.racinggamewaterfall.Controllers.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <HBox prefHeight="100.0" prefWidth="200.0">
      <children>
          <GridPane prefHeight="100.0" prefWidth="156.0">
              <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" valignment="CENTER" vgrow="ALWAYS" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
              <children>
                  <Label alignment="CENTER" contentDisplay="CENTER" text="Cars">
                      <font>
                          <Font name="System Bold" size="14.0" />
                      </font>
                      <GridPane.margin>
                          <Insets />
                      </GridPane.margin></Label>
                  <Label alignment="CENTER" contentDisplay="CENTER" layoutX="10.0" layoutY="26.0" text="Score" GridPane.columnIndex="1">
                      <font>
                          <Font name="System Bold" size="14.0" />
                      </font>
                      <GridPane.margin>
                          <Insets />
                      </GridPane.margin></Label>
                  <Label fx:id="carOneScore" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="1">
                      <GridPane.margin>
                          <Insets />
                      </GridPane.margin></Label>
                  <Label text="Label" GridPane.rowIndex="3">
                      <GridPane.margin>
                          <Insets />
                      </GridPane.margin></Label>
                  <Label text="Label" GridPane.rowIndex="2">
                      <GridPane.margin>
                          <Insets />
                      </GridPane.margin></Label>
                  <Label text="My Car" GridPane.rowIndex="1">
                      <GridPane.margin>
                          <Insets />
                      </GridPane.margin></Label>
                  <Label fx:id="carThreeScore" layoutX="69.0" layoutY="45.0" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="3">
                      <GridPane.margin>
                          <Insets />
                      </GridPane.margin></Label>
                  <Label fx:id="carTwoScore" layoutX="69.0" layoutY="45.0" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="2">
                      <GridPane.margin>
                          <Insets />
                      </GridPane.margin></Label>
                  <Label layoutX="69.0" layoutY="45.0" text="Label" GridPane.rowIndex="4">
                      <GridPane.margin>
                          <Insets />
                      </GridPane.margin></Label>
                  <Label fx:id="carFourScore" layoutX="69.0" layoutY="103.0" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="4">
                      <GridPane.margin>
                          <Insets />
                      </GridPane.margin></Label>
              </children>
              <padding>
                  <Insets left="10.0" right="10.0" />
              </padding>
          </GridPane>
           <Label fx:id="statusLabel" prefHeight="115.0" prefWidth="185.0" text="🏁 Race Car Game 🏁">
            <font>
               <Font size="19.0" />
            </font></Label>
          <GridPane prefHeight="100.0" prefWidth="272.0">
              <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
              <children>
                  <CheckBox mnemonicParsing="false" text="Speed Boost" />
                  <CheckBox mnemonicParsing="false" text="Low Nitrox" GridPane.rowIndex="2" />
                  <CheckBox mnemonicParsing="false" text="Low fuel" GridPane.rowIndex="1" />
                  <CheckBox layoutX="10.0" layoutY="26.0" mnemonicParsing="false" text="Speed Boost" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <CheckBox layoutX="10.0" layoutY="26.0" mnemonicParsing="false" prefHeight="17.0" prefWidth="119.0" text="Speed Boost" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <CheckBox layoutX="10.0" layoutY="26.0" mnemonicParsing="false" text="Speed Boost" GridPane.columnIndex="1" />
              </children>
              <padding>
                  <Insets left="20.0" right="20.0" />
              </padding>
          </GridPane>
      </children>
   </HBox>
    <VBox alignment="CENTER" spacing="10" BorderPane.alignment="CENTER">
        <Button onAction="#startRace" text="Start Race" />
      <padding>
         <Insets bottom="10.0" />
      </padding>
    </VBox>
    <Pane fx:id="trackPane" prefHeight="300" prefWidth="600" style="-fx-background-color: lightgray;">
      <children>
         <ImageView fitHeight="300.0" fitWidth="600.0" layoutY="1.0" pickOnBounds="true" smooth="false">
            <image>
               <Image url="@raceTrack.png" />
            </image>
         </ImageView>
      </children></Pane>

</VBox>
